{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sections.schema.json",
  "title": "All Sections Schema",
  "description": "Uproszczone schematy wszystkich sekcji - skupione na CONTENT, nie na STYLE",

  "definitions": {

    "navigation": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["fixed-transparent", "fixed-solid", "static"],
          "default": "fixed-transparent"
        },
        "logo": {
          "type": "object",
          "properties": {
            "type": { "enum": ["initials", "text", "image"], "default": "initials" },
            "value": { "type": "string" },
            "secondaryText": { "type": "string" }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        },
        "cta": {
          "type": "object",
          "properties": {
            "type": { "enum": ["phone", "button", "none"], "default": "phone" },
            "text": { "type": "string" },
            "href": { "type": "string" }
          }
        }
      }
    },

    "hero": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["fullscreen-left", "fullscreen-center", "split-left", "split-right"],
          "default": "fullscreen-left"
        },
        "badge": { "type": "string" },
        "headline": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Każdy element = nowa linia"
        },
        "headlineAccent": {
          "type": "integer",
          "description": "Która linia ma być wyróżniona (0-indexed)"
        },
        "subtitle": { "type": "string" },
        "ctaPrimary": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "href": { "type": "string" },
            "type": { "enum": ["phone", "email", "link"], "default": "phone" }
          }
        },
        "ctaSecondary": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "scrollTo": { "type": "string" }
          }
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "backgroundImage": { "type": "string" },
        "showBadge": { "type": "boolean", "default": true },
        "showStats": { "type": "boolean", "default": true },
        "showRebarPattern": { "type": "boolean", "default": true },
        "showDecorations": { "type": "boolean", "default": true },
        "showScrollIndicator": { "type": "boolean", "default": true }
      },
      "required": ["headline", "ctaPrimary"]
    },

    "whyUs": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["4-column-icons", "3-column-cards", "2-column-split"],
          "default": "4-column-icons"
        },
        "sectionLabel": { "type": "string", "default": "/ DLACZEGO MY" },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "subtitle": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": { "type": "string", "description": "Nazwa ikony z lucide-react lub ścieżka do obrazka" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      },
      "required": ["title", "items"]
    },

    "services": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["tabs-with-image", "cards-grid", "accordion"],
          "default": "tabs-with-image"
        },
        "sectionLabel": { "type": "string", "default": "/ USŁUGI" },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "subtitle": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "icon": { "type": "string" },
              "title": { "type": "string" },
              "shortDesc": { "type": "string" },
              "fullDesc": { "type": "string" },
              "image": { "type": "string" },
              "features": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "required": ["title", "items"]
    },

    "forWhom": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["2x2-grid", "4-column", "carousel"],
          "default": "2x2-grid"
        },
        "sectionLabel": { "type": "string", "default": "/ ODBIORCY" },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "sideInfo": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "image": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "required": ["title", "items"]
    },

    "process": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["4-column-timeline", "vertical-steps", "numbered-list"],
          "default": "4-column-timeline"
        },
        "sectionLabel": { "type": "string", "default": "/ PROCES" },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": { "type": "string" },
              "icon": { "type": "string" },
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "bottomCta": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "href": { "type": "string" }
          }
        }
      },
      "required": ["title", "steps"]
    },

    "portfolio": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["mosaic", "grid-3col", "carousel"],
          "default": "mosaic"
        },
        "sectionLabel": { "type": "string", "default": "/ REALIZACJE" },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "category": { "type": "string" },
              "specs": { "type": "string" },
              "image": { "type": "string" },
              "featured": { "type": "boolean", "default": false }
            }
          }
        },
        "showGalleryButton": { "type": "boolean", "default": true },
        "galleryButtonText": { "type": "string", "default": "Zobacz Pełną Galerię" }
      },
      "required": ["title", "projects"]
    },

    "faq": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["accordion-centered", "accordion-split", "grid"],
          "default": "accordion-centered"
        },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" }
            }
          }
        }
      },
      "required": ["title", "questions"]
    },

    "contact": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["split-with-map", "form-only", "cards"],
          "default": "split-with-map"
        },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "subtitle": { "type": "string" },
        "showPhone": { "type": "boolean", "default": true },
        "phoneLabel": { "type": "string", "default": "Telefon" },
        "showEmail": { "type": "boolean", "default": true },
        "emailLabel": { "type": "string", "default": "Email" },
        "showAddress": { "type": "boolean", "default": true },
        "showNip": { "type": "boolean", "default": true },
        "showMap": { "type": "boolean", "default": true },
        "mapEmbedUrl": { "type": "string" }
      },
      "required": ["title"]
    },

    "footer": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["4-column", "simple", "mega"],
          "default": "4-column"
        },
        "description": { "type": "string" },
        "navLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        },
        "showBigTypography": { "type": "boolean", "default": true },
        "copyright": { "type": "string" }
      }
    }
  }
}
